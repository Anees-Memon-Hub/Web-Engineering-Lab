<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Alumni Profile</title><link rel="stylesheet" href="/style.css"></head><body>
<header class="app-topbar"><a class="topbar-brand" href="/">Alumni Hub</a><div class="topbar-user"><span>Signed in as <strong><%= currentUser ? currentUser.name : '' %></strong></span><form method="POST" action="/logout"><button type="submit" class="logout-button">Log out</button></form></div></header>
<div class="container"><header class="topbar"><div><h1>Alumni Profile</h1><p>Record #<%=alumni.id%></p></div><div class="actions"><a class="btn light" href="/">Back</a><a class="btn secondary" href="/edit/<%=alumni.id%>">Edit</a><a class="btn" href="/pdf/<%=alumni.id%>">Export PDF</a></div></header><div class="profile-head"><%if(alumni.profile_image){%><img class="profile-large" src="/uploads/<%=alumni.profile_image%>"><%}else{%><div class="profile-large placeholder">?</div><%}%><div><h2><%=alumni.full_name%></h2><p><%=alumni.email%></p><p><%=alumni.department||'Department not specified'%></p></div></div><div class="detail-grid"><%[['Phone',alumni.phone],['DOB',alumni.dob],['Gender',alumni.gender],['Graduation Year',alumni.graduation_year],['CGPA',alumni.cgpa],['Degree',alumni.degree_program],['Employment',alumni.employment_status],['Company',alumni.company],['Job Title',alumni.job_title],['Skills',alumni.skills],['Contact',alumni.contact_preference],['LinkedIn',alumni.linkedin],['Newsletter',alumni.newsletter?'Yes':'No']].forEach(([k,v])=>{%><div class="detail"><strong><%=k%></strong><span><%=v||'-'%></span></div><%})%></div><div class="bio"><h3>Bio</h3><p><%=alumni.bio||'No bio provided.'%></p></div><%if(alumni.resume){%><p><strong>Resume:</strong> <a href="/uploads/documents/<%=alumni.resume%>" target="_blank">Open Resume</a></p><%}%></div></body></html>
