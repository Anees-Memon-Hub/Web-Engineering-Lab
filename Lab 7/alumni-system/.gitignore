```gitignore
# Node.js dependencies
node_modules/

# Environment variables / secrets
.env
.env.local
.env.*.local

# Uploaded files
public/uploads/*
!public/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# VS Code / IDE
.vscode/
.idea/

# Temporary files
*.tmp
*.temp

# Build / coverage
dist/
build/
coverage/
```
