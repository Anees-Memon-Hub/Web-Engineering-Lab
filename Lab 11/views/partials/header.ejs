<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <header>Alumni Management System</header>

    <nav class="navbar">
        <div class="logo">AlumniConnect</div>
        <ul class="nav-links">
            <% if (user) { %>
                <li><a href="/" class="<%= active === 'dashboard' ? 'active' : '' %>">Dashboard</a></li>
                <li><a href="/alumni" class="<%= active === 'alumni' ? 'active' : '' %>">Alumni</a></li>
                <li><a href="/profile" class="<%= active === 'profile' ? 'active' : '' %>">Profile</a></li>
                <li><a href="/chat" class="<%= active === 'chat' ? 'active' : '' %>">Chat</a></li>
                <li><a href="/contact" class="<%= active === 'contact' ? 'active' : '' %>">Contact</a></li>
                <li>
                    <form action="/logout" method="POST" class="nav-logout">
                        <button type="submit">Logout (<%= user.name.split(' ')[0] %>)</button>
                    </form>
                </li>
            <% } else { %>
                <li><a href="/login" class="<%= active === 'login' ? 'active' : '' %>">Login</a></li>
                <li><a href="/register" class="<%= active === 'register' ? 'active' : '' %>">Register</a></li>
            <% } %>
        </ul>
    </nav>

    <main>
        <% if (flash) { %>
            <div class="alert alert-success"><%= flash %></div>
        <% } %>
