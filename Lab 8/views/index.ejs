<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Alumni Management</title><link rel="stylesheet" href="/style.css"></head><body><div class="container wide"><header class="topbar"><div><h1>Alumni Management System</h1><p>CRUD Dashboard • EJS • Express • MySQL • PDF</p></div><div class="actions"><a class="btn" href="/register">+ Add Alumni</a><a class="btn secondary" href="/pdf">Export All PDF</a></div></header><form class="search" method="get"><input name="q" value="<%= q %>" placeholder="Search by name, email or department"><button class="btn">Search</button><a class="btn light" href="/">Clear</a></form><div class="table-wrap"><table><thead><tr><th>ID</th><th>Profile</th><th>Name</th><th>Email</th><th>Department</th><th>Year</th><th>Status</th><th>Actions</th></tr></thead><tbody><% if(!alumni.length){ %><tr><td colspan="8" class="empty">No records found.</td></tr><% } %><% alumni.forEach(a=>{ %><tr><td><%=a.id%></td><td><%if(a.profile_image){%><img class="avatar" src="/uploads/<%=a.profile_image%>"><%}else{%><div class="avatar placeholder">?</div><%}%></td><td><strong><%=a.full_name%></strong></td><td><%=a.email%></td><td><%=a.department||'-'%></td><td><%=a.graduation_year||'-'%></td><td><%=a.employment_status||'-'%></td><td class="actions-cell"><a class="small-btn view" href="/view/<%=a.id%>">View</a><a class="small-btn edit" href="/edit/<%=a.id%>">Edit</a><a class="small-btn pdf" href="/pdf/<%=a.id%>">PDF</a><form method="post" action="/delete/<%=a.id%>" onsubmit="return confirm('Delete this alumni record?')"><button class="small-btn delete">Delete</button></form></td></tr><%})%></tbody></table></div></div></body></html>
