<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=title%></title><link rel="stylesheet" href="/style.css"></head><body><div class="container"><header class="topbar"><div><h1><%=title%></h1><p>Alumni Management System</p></div><a class="btn light" href="/">← Back</a></header><form action="<%=action%>" method="post" enctype="multipart/form-data"><h2>Personal Information</h2><div class="grid"><div><label>Full Name *</label><input name="full_name" value="<%=alumni?.full_name||''%>" required></div><div><label>Email *</label><input type="email" name="email" value="<%=alumni?.email||''%>" required></div><%if(!alumni){%><div><label>Password *</label><input type="password" name="password" minlength="6" required></div><%}%><div><label>Phone</label><input name="phone" value="<%=alumni?.phone||''%>"></div><div><label>Date of Birth</label><input type="date" name="dob" value="<%=alumni?.dob?String(alumni.dob).slice(0,10):''%>"></div></div><label>Gender</label><div class="options"><%['Male','Female','Other'].forEach(v=>{%><label><input type="radio" name="gender" value="<%=v%>" <%=alumni?.gender===v?'checked':''%>> <%=v%></label><%})%></div><h2>Academic Information</h2><div class="grid"><div><label>Department</label><select name="department"><option value="">Select</option><%['Computer Science','Information Technology','Software Engineering','Electrical Engineering','Business Administration'].forEach(v=>{%><option <%=alumni?.department===v?'selected':''%>><%=v%></option><%})%></select></div><div><label>Graduation Year</label><select name="graduation_year"><option value="">Select</option><%[2022,2023,2024,2025,2026].forEach(v=>{%><option value="<%=v%>" <%=String(alumni?.graduation_year||'')===String(v)?'selected':''%>><%=v%></option><%})%></select></div><div><label>CGPA</label><input type="number" name="cgpa" min="0" max="4" step="0.01" value="<%=alumni?.cgpa||''%>"></div></div><label>Degree Program</label><div class="options"><%['BS','MS','PhD'].forEach(v=>{%><label><input type="radio" name="degree_program" value="<%=v%>" <%=alumni?.degree_program===v?'checked':''%>> <%=v%></label><%})%></div><h2>Professional Information</h2><div class="grid"><div><label>Employment Status</label><select name="employment_status"><option value="">Select</option><%['Student','Employed','Self Employed','Unemployed'].forEach(v=>{%><option <%=alumni?.employment_status===v?'selected':''%>><%=v%></option><%})%></select></div><div><label>Company</label><input name="company" value="<%=alumni?.company||''%>"></div><div><label>Job Title</label><input name="job_title" value="<%=alumni?.job_title||''%>"></div></div><label>Skills</label><div class="options"><%const ss=(alumni?.skills||'').split(',').map(s=>s.trim());['HTML','CSS','JavaScript','Node.js','PHP','Python','MySQL'].forEach(v=>{%><label><input type="checkbox" name="skills" value="<%=v%>" <%=ss.includes(v)?'checked':''%>> <%=v%></label><%})%></div><h2>Contact & Profile</h2><div class="grid"><div><label>Contact Preference</label><select name="contact_preference"><%['','Email','Phone','WhatsApp'].forEach(v=>{%><option value="<%=v%>" <%=alumni?.contact_preference===v?'selected':''%>><%=v||'Select'%></option><%})%></select></div><div><label>LinkedIn</label><input type="url" name="linkedin" value="<%=alumni?.linkedin||''%>"></div></div><label>Bio</label><textarea name="bio" rows="5"><%=alumni?.bio||''%></textarea><h2>Uploads</h2><div class="upload-box"><label>Profile Image <%=alumni?'':'*'%></label><input type="file" name="profile_image" accept="image/png,image/jpeg,image/gif" <%=alumni?'':'required'%>><small>JPG/JPEG/PNG/GIF, max 2 MB.</small></div><div class="upload-box"><label>Resume / CV</label><input type="file" name="resume" accept=".pdf,.doc,.docx"><small>PDF/DOC/DOCX, max 2 MB.</small></div><div class="options"><label><input type="checkbox" name="newsletter" value="1" <%=alumni?.newsletter?'checked':''%>> Newsletter</label><%if(!alumni){%><label><input type="checkbox" name="terms_accepted" value="1" required> Terms & Conditions *</label><%}%></div><div class="buttons"><button class="btn"><%=alumni?'Update Alumni':'Save Alumni'%></button><a class="btn light" href="/">Cancel</a></div></form></div></body></html>
