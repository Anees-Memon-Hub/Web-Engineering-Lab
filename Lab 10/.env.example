# Copy this file to .env and fill in your real values.
# .env itself must never be committed to Git (see .gitignore) since it holds
# real database credentials and the session secret.

# --- Local XAMPP/MySQL ---
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=alumni_system

# --- freedb.tech (get these values from your freedb dashboard) ---
DB_HOST=sql.freedb.tech
DB_PORT=3306
DB_USER=freedb_yourusername
DB_PASSWORD=your-freedb-password
DB_NAME=freedb_alumni_system

# Signs the session cookie. Use a long random value, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

PORT=3000

# Optional settings
# SESSION_MINUTES=120      # how long a login lasts (use 1 to demo expiry)
# DB_POOL_LIMIT=1          # database connections; free hosts allow very few
# NODE_ENV=production      # only on a real HTTPS server: makes the cookie HTTPS-only

# --- Lab 10: SMTP email (Gmail example) ---
# Enable 2-Step Verification on your Google account and generate an App Password.
# Do not use your normal Gmail password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
CONTACT_TO=admin-email@example.com
